# ============================================================
# 生产环境配置：复制为项目根目录的 .env 后填写
# 不要提交真实 .env、App Secret、站点密码或推送 Token
# ============================================================

TZ=Asia/Shanghai

# MeimoAI 签到站点账号
MEIMOAI_ACCOUNT=
MEIMOAI_PASSWORD=
MEIMOAI_URL=https://meimoai13.com/

CRON_SCHEDULE=0 1 * * *
RANDOM_DELAY=true
RANDOM_DELAY_MAX_MINUTES=300
SKIP_PROBABILITY=0.05
MAX_CONSECUTIVE_FAILURES=3
PROXY_SERVER=

# 推送渠道（留空 = 不启用）
WANWAN_PUSH_TOKEN=
PUSHPLUS_TOKEN=
SERVERCHAN_SENDKEY=
WEBHOOK_URL=

# ============================================================
# 飞书企业 SSO
# 飞书开放平台重定向 URL 必须与此处完全一致
# ============================================================
FEISHU_SSO_ENABLED=true
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_REDIRECT_URI=https://check.wanwanpro.top/api/auth/feishu/callback
# 两项至少填一项；两项都为空会拒绝所有飞书账号
FEISHU_ALLOWED_TENANT_KEYS=
FEISHU_ALLOWED_OPEN_IDS=
FEISHU_SCOPE=

# 紧急管理密码，推荐使用 scrypt 哈希：npm run hash
WEB_PASSWORD=

# Caddy/Nginx 反向代理下信任 1 跳代理，使登录限流能识别真实客户端 IP
WEB_TRUST_PROXY=1

# 宿主机回环端口，由反向代理转发
HOST_PORT=7788