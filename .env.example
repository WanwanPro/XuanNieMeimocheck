# ============================================================
# 复制本文件为 .env 并填写真实值（.env 已被 .gitignore 忽略）
# ⚠️ 安全警告：此文件包含敏感凭据，切勿提交到 git、分享或备份到公开位置
# ⚠️ 如果旧版 docker-compose.yml 中的明文密码/token 曾泄露，请立即：
#    1. 修改 MeimoAI 站点登录密码
#    2. 重置所有推送平台的 token
# ============================================================

# 容器时区（同时影响 cron 的 0 1 * * * 何时执行）
TZ=Asia/Shanghai

# MeimoAI 签到站点账号
MEIMOAI_ACCOUNT=
MEIMOAI_PASSWORD=
MEIMOAI_URL=https://meimoai13.com/

# 定时签到规则（5 段 cron 表达式，按 TZ 指定时区执行）
CRON_SCHEDULE=0 1 * * *

# 随机延迟与行为节奏（防风控）
RANDOM_DELAY=true
RANDOM_DELAY_MAX_MINUTES=300
# 每次自动签到按概率跳过，避免形成每天固定执行的完美周期；0 = 不跳过
SKIP_PROBABILITY=0.05
# 连续失败或连续 clicked（结果不确定）达到该次数后熔断暂停；可在 Web 页面手动恢复
MAX_CONSECUTIVE_FAILURES=3

# 代理服务器（可选，例如 http://host:port 或 socks5://host:port）
PROXY_SERVER=

# 推送渠道（留空 = 不启用）
WANWAN_PUSH_TOKEN=
PUSHPLUS_TOKEN=
SERVERCHAN_SENDKEY=
WEBHOOK_URL=

# ============================================================
# 飞书企业 SSO（可选；配置齐全后手机飞书内可"即点即用"免登）
# ============================================================
# 开启前需在飞书开放平台创建【企业自建应用】，并完成：
#   1. 安全设置 -> 重定向 URL 添加 https://你的域名/api/auth/feishu/callback
#   2. 权限管理开通「获取用户基本信息」(authen:user.id.obtain, contact:user.base:readonly)
#   3. 发布版本并等待企业管理员审核通过（未发布时授权会报 20029/20027）
FEISHU_SSO_ENABLED=false
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_REDIRECT_URI=
# 白名单：两项都留空 = 拒绝所有飞书登录；至少填其中一项。
# FEISHU_ALLOWED_TENANT_KEYS 填企业 tenant_key（同企业所有人可登录）
# FEISHU_ALLOWED_OPEN_IDS 填具体用户 open_id（仅名单内用户可登录）
# 多个值用逗号分隔；open_id 获取方式：先放开企业白名单登录一次，日志 [FEISHU] 拒绝/成功条目会打印 open_id。
FEISHU_ALLOWED_TENANT_KEYS=
FEISHU_ALLOWED_OPEN_IDS=
# 可选，默认空（使用应用默认权限）
FEISHU_SCOPE=

# Web 管理密码（留空 = 关闭认证，仅限内网使用，严禁上公网！）
# 推荐填 scrypt 哈希，生成方式：npm run hash
WEB_PASSWORD=

# 仅在明确受控的反向代理后启用（留空=false；推荐填代理跳数如 1，或 loopback / 具体 IP/CIDR）。
# 不要使用 true/all：那会信任任意客户端伪造的 X-Forwarded-For，使登录限流失效。修改后必须重启容器。
WEB_TRUST_PROXY=
